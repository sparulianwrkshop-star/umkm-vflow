# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── API Security ──────────────────────────────────────────────────────────────
# Ganti dengan string acak yang kuat (min 32 karakter)
API_KEY=ganti-dengan-api-key-rahasia-anda

# ── VFlow Server ──────────────────────────────────────────────────────────────
VFLOW_BASE_URL=http://localhost:8080
VFLOW_TIMEOUT_MS=10000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
